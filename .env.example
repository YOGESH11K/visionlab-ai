# =========================================================================
# EMPIRE — environment configuration (copy to .env and adjust)
# Never commit the real .env. Keep secrets out of the repository.
# =========================================================================

# --- Backend server ------------------------------------------------------
EMPIRE_HOST=127.0.0.1
EMPIRE_PORT=8000
EMPIRE_DEBUG=true
EMPIRE_LOG_LEVEL=INFO
EMPIRE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ------------------------------------------------------------
# SQLite path (default: backend/data/empire.db)
EMPIRE_DB_URL=sqlite:///./data/empire.db
# PostgreSQL example (ready-to-swap, requires psycopg):
# EMPIRE_DB_URL=postgresql+psycopg://user:pass@localhost:5432/empire

# --- Camera / vision ------------------------------------------------------
# Camera index used by the backend VideoCapture (0 = default webcam, -1 = disable)
EMPIRE_CAMERA_INDEX=0
# Target processing resolution
EMPIRE_VISION_WIDTH=640
EMPIRE_VISION_HEIGHT=480
# Frame throttle for WebSocket streaming (fps)
EMPIRE_STREAM_FPS=15
# Detection/gesture inference throttle (inferences per second max)
EMPIRE_INFERENCE_FPS=12

# --- Serial / hardware -----------------------------------------------------
EMPIRE_SERIAL_BAUD=9600
EMPIRE_SERIAL_TIMEOUT=0.1
EMPIRE_DEFAULT_BOARD=Arduino Uno

# --- AI (optional) ----------------------------------------------------------
# Leave empty to use the built-in verified knowledge engine (no internet).
# If set, the AI assistant may call an OpenAI-compatible chat completion API.
EMPIRE_AI_API_KEY=
EMPIRE_AI_BASE_URL=https://api.openai.com/v1
EMPIRE_AI_MODEL=gpt-4o-mini
EMPIRE_AI_TIMEOUT=30
